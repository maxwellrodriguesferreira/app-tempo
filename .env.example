# ==============================================================================
# WEATHER HUB / CLIMASTACK - VARIÁVEIS DE AMBIENTE
# ==============================================================================
# Copie este arquivo para .env e preencha com as credenciais do seu ambiente.
# NUNCA versione o arquivo .env no Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações da Aplicação & Servidor HTTP
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
APP_BASE_URL=http://localhost:8080

# Credenciais Iniciais de Administrador (Provisionamento automático de Admin)
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASS=SuaSenhaForte123!

# ------------------------------------------------------------------------------
# 2. Persistência: Cloudflare D1 (Banco Gerenciado Externo)
# ------------------------------------------------------------------------------
# Opção A: Worker Proxy Privado (Recomendado para servidores fora da Cloudflare)
# Exponha um Cloudflare Worker autenticado com binding nativo para seu banco D1.
D1_API_URL=https://weather-hub-d1-proxy.example.workers.dev
D1_API_TOKEN=your_secure_worker_bearer_token_here

# Opção B: Cloudflare D1 REST API Direta Oficial
# Utilize estas variáveis caso opte pela API REST oficial da Cloudflare.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# ------------------------------------------------------------------------------
# 3. Redis Remoto (Proteção contra Força Bruta & Cache de Sessões)
# ------------------------------------------------------------------------------
# Conecte-se a um provedor externo gerenciado (Upstash, Redis Cloud, Aiven, etc.)
# Utilize o protocolo 'rediss://' para forçar TLS quando exigido pelo provedor.
REDIS_URL=rediss://default:your_redis_password@your-redis-provider-endpoint.com:6379
REDIS_TLS_ENABLED=true
REDIS_CONNECT_TIMEOUT_MS=4000
REDIS_MAX_RETRIES_PER_REQUEST=2

# ------------------------------------------------------------------------------
# 4. Segurança de Sessões & Criptografia
# ------------------------------------------------------------------------------
# Chave aleatória criptograficamente segura de no mínimo 32 caracteres
SESSION_SECRET=generate_a_secure_random_string_with_at_least_32_characters_here
SESSION_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# 5. Políticas de Rate Limiting (Brute-Force Protection)
# ------------------------------------------------------------------------------
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_LOCKOUT_SECONDS=900

# ------------------------------------------------------------------------------
# 6. Provedor de Previsão Meteorológica
# ------------------------------------------------------------------------------
# Opções: 'open-meteo' (padrão, alta resolução, gratuito) ou 'openweathermap'
WEATHER_PROVIDER=open-meteo
# Obrigatória apenas se utilizar 'openweathermap':
WEATHER_API_KEY=
