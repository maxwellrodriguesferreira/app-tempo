name = "weather-hub-d1-proxy"
main = "index.ts"
compatibility_date = "2024-09-23"

# Binding nativo com o Cloudflare D1
[[d1_databases]]
binding = "DB"
database_name = "weather-hub-db"
database_id = "seu-d1-database-id-aqui"

# O token secreto deve ser configurado via linha de comando com:
# wrangler secret put AUTH_TOKEN
